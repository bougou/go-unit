---
const base = import.meta.env.BASE_URL;
const home = new URL(base, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${base}`} />
    <link rel="canonical" href={home.href} />
    <title>go-unit</title>
  </head>
  <body>
    <a href={base}>go-unit</a>
  </body>
</html>
